# Copier ce fichier, le renommer en .env, puis remplacer les valeurs entre < >

# Chaîne de connexion MongoDB Atlas avec l'utilisateur et le mot de passe de la base
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/monvieuxgrimoire

# Clé secrète pour signer les tokens JWT
JWT_SECRET=<cle_secrete>